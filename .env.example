# Kroger Public API
# Copy these keys into .env.local. Never commit the real secret.
KROGER_ENV=certification
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:8787/api/kroger-oauth/callback

# Server-side Kroger OAuth persistence
KROGER_TOKEN_ENCRYPTION_KEY=
SIMPLE_DINNERS_APP_ORIGIN=https://dinners.ncocaptain.com

# Server-side Supabase access for Kroger connections
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client feature gate / native API base
VITE_KROGER_ENABLED=false
VITE_API_BASE_URL=
